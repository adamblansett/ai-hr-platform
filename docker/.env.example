# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_hr_db
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0

# Security & Tokens
SECRET_KEY=replace-with-a-64-character-random-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers (Local Ollama & Cloud Fallbacks)
PRIMARY_LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
FALLBACK_OPENAI_API_KEY=
FALLBACK_ANTHROPIC_API_KEY=

# Upstream Webhook Ingestion (ai-recruiter handoff)
RECRUITER_WEBHOOK_SECRET=super-secure-shared-webhook-token
