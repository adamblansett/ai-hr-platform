    {
      "name": "Upstream Webhooks (ai-recruiter)",
      "item": [
        {
          "name": "Offer Accepted Candidate Handoff",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Recruiter-Signature", "value": "sha256=COMPUTED_HMAC_DIGEST" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_id\": \"evt_demo_101\",\n  \"event_type\": \"candidate.offer_accepted\",\n  \"timestamp\": \"2026-11-18T10:00:00Z\",\n  \"organization_id\": \"11111111-1111-1111-1111-111111111111\",\n  \"candidate\": {\n    \"recruiter_candidate_id\": \"cand_9941\",\n    \"first_name\": \"Marcus\",\n    \"last_name\": \"Vance\",\n    \"email\": \"marcus.vance@example.com\",\n    \"job_title\": \"Principal AI Systems Architect\",\n    \"department\": \"Platform Engineering\",\n    \"hire_date\": \"2026-12-01\",\n    \"employment_type\": \"FULL_TIME\",\n    \"manager_email\": \"manager.sarah@acme.corp\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/webhooks/recruiter/offer-accepted",
              "host": ["{{baseUrl}}"],
              "path": ["webhooks", "recruiter", "offer-accepted"]
            }
          }
        }
      ]
    },
